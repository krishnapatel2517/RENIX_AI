{
  "name": "renix_transition",
  "version": "1.0",
  "description": "Smooth holographic transition animation used when RENIX switches between interface states, panels, views, or modes.",
  "loop": false,
  "duration": 0.8,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.75,
      "distortion": 0.0,
      "progress": 0.0
    },
    {
      "time": 0.12,
      "opacity": 0.95,
      "scale": 1.015,
      "x": -3.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.95,
      "distortion": 0.12,
      "progress": 0.2
    },
    {
      "time": 0.25,
      "opacity": 0.75,
      "scale": 1.03,
      "x": 5.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 1.1,
      "distortion": 0.22,
      "progress": 0.4
    },
    {
      "time": 0.4,
      "opacity": 0.5,
      "scale": 1.02,
      "x": -4.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 1.0,
      "distortion": 0.3,
      "progress": 0.6
    },
    {
      "time": 0.55,
      "opacity": 0.7,
      "scale": 0.98,
      "x": 3.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.9,
      "distortion": 0.18,
      "progress": 0.8
    },
    {
      "time": 0.7,
      "opacity": 0.9,
      "scale": 0.995,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.8,
      "distortion": 0.05,
      "progress": 0.95
    },
    {
      "time": 0.8,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.75,
      "distortion": 0.0,
      "progress": 1.0
    }
  ],

  "effects": {
    "glitch": {
      "enabled": true,
      "strength": 0.22,
      "duration": 0.35,
      "startTime": 0.1,
      "frequency": 18
    },

    "scanline": {
      "enabled": true,
      "strength": 0.2,
      "speed": 3.0,
      "direction": "left_to_right"
    },

    "glow": {
      "enabled": true,
      "minimum": 0.55,
      "maximum": 1.1,
      "speed": 3.2
    },

    "particles": {
      "enabled": true,
      "count": 55,
      "movement": "crossfade",
      "speed": 1.0,
      "radius": 1.25
    },

    "transitionSweep": {
      "enabled": true,
      "direction": "left_to_right",
      "speed": 2.5,
      "width": 0.12,
      "intensity": 0.8
    },

    "distortion": {
      "enabled": true,
      "strength": 0.3,
      "frequency": 8.0,
      "fadeIn": 0.1,
      "fadeOut": 0.3
    }
  },

  "status": {
    "displayText": "TRANSITION",
    "showIndicator": false,
    "indicatorPulse": false
  },

  "sound": {
    "enabled": false,
    "asset": "assets/sounds/transition.wav",
    "volume": 0.25
  },

  "onComplete": {
    "nextState": "idle"
  },

  "easing": {
    "default": "ease_in_out",
    "entrance": "ease_out",
    "exit": "ease_in",
    "distortion": "ease_in_out"
  }
}