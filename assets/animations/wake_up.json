{
  "name": "renix_wake_up",
  "version": "1.0",
  "description": "Wake-up animation triggered when RENIX detects its wake word or activation clap.",
  "loop": false,
  "duration": 1.6,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 0.35,
      "scale": 0.82,
      "rotation": 0.0,
      "glow": 0.25,
      "pulse": 0.0,
      "scan": 0.0
    },
    {
      "time": 0.15,
      "opacity": 0.55,
      "scale": 0.88,
      "rotation": 0.0,
      "glow": 0.45,
      "pulse": 0.5,
      "scan": 0.25
    },
    {
      "time": 0.35,
      "opacity": 0.85,
      "scale": 1.06,
      "rotation": 0.0,
      "glow": 0.95,
      "pulse": 1.0,
      "scan": 0.75
    },
    {
      "time": 0.55,
      "opacity": 1.0,
      "scale": 0.98,
      "rotation": 0.0,
      "glow": 1.15,
      "pulse": 0.7,
      "scan": 1.0
    },
    {
      "time": 0.8,
      "opacity": 1.0,
      "scale": 1.02,
      "rotation": 0.0,
      "glow": 1.0,
      "pulse": 0.45,
      "scan": 0.65
    },
    {
      "time": 1.1,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.9,
      "pulse": 0.2,
      "scan": 0.35
    },
    {
      "time": 1.6,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.0,
      "scan": 0.0
    }
  ],

  "effects": {
    "energyRing": {
      "enabled": true,
      "startTime": 0.2,
      "duration": 0.9,
      "startScale": 0.35,
      "endScale": 1.8,
      "opacity": 0.8
    },

    "particleBurst": {
      "enabled": true,
      "startTime": 0.15,
      "duration": 0.65,
      "intensity": 0.75,
      "direction": "outward"
    },

    "scan": {
      "enabled": true,
      "startTime": 0.2,
      "duration": 0.8,
      "speed": 3.0,
      "strength": 0.45
    },

    "glow": {
      "enabled": true,
      "peakTime": 0.45,
      "peakStrength": 1.15
    },

    "flicker": {
      "enabled": true,
      "startTime": 0.0,
      "duration": 0.5,
      "strength": 0.12,
      "frequency": 9.0
    }
  },

  "sound": {
    "enabled": true,
    "asset": "assets/sounds/wake.wav",
    "volume": 0.65
  },

  "onComplete": {
    "nextState": "listening"
  },

  "easing": {
    "default": "ease_in_out",
    "activation": "ease_out",
    "settle": "ease_in_out"
  }
}