{
  "name": "renix_speaking",
  "version": "1.0",
  "description": "Speaking animation displayed while RENIX is generating and delivering a voice response.",
  "loop": true,
  "duration": 1.8,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.2,
      "wave": 0.2
    },
    {
      "time": 0.45,
      "opacity": 1.0,
      "scale": 1.018,
      "rotation": 0.4,
      "glow": 1.0,
      "pulse": 0.65,
      "wave": 0.7
    },
    {
      "time": 0.9,
      "opacity": 1.0,
      "scale": 1.035,
      "rotation": 0.0,
      "glow": 1.12,
      "pulse": 1.0,
      "wave": 1.0
    },
    {
      "time": 1.35,
      "opacity": 1.0,
      "scale": 1.018,
      "rotation": -0.4,
      "glow": 1.0,
      "pulse": 0.65,
      "wave": 0.7
    },
    {
      "time": 1.8,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.2,
      "wave": 0.2
    }
  ],

  "effects": {
    "voiceWave": {
      "enabled": true,
      "bars": 32,
      "minimumHeight": 0.12,
      "maximumHeight": 1.0,
      "speed": 5.0,
      "reactToAudio": true,
      "smoothing": 0.8
    },

    "audioPulse": {
      "enabled": true,
      "reactToAudio": true,
      "sensitivity": 0.85,
      "minimumScale": 1.0,
      "maximumScale": 1.08
    },

    "glow": {
      "enabled": true,
      "minimum": 0.75,
      "maximum": 1.15,
      "speed": 2.2
    },

    "particles": {
      "enabled": true,
      "count": 120,
      "movement": "orbital",
      "speed": 1.0,
      "radius": 1.4,
      "reactToAudio": true
    },

    "scanline": {
      "enabled": true,
      "strength": 0.2,
      "speed": 1.8
    }
  },

  "audio": {
    "enabled": true,
    "outputReactive": true,
    "sensitivity": 0.85,
    "smoothing": 0.75
  },

  "status": {
    "displayText": "SPEAKING",
    "showIndicator": true,
    "indicatorPulse": true
  },

  "onComplete": {
    "nextState": "idle"
  },

  "easing": {
    "default": "ease_in_out",
    "audioResponse": "ease_out"
  }
}