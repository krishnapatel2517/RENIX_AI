{
  "name": "renix_rotate",
  "version": "1.0",
  "description": "Smooth holographic rotation animation for RENIX interface elements.",
  "loop": true,
  "duration": 2.4,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 0.85,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.7,
      "pulse": 0.2
    },
    {
      "time": 0.4,
      "opacity": 0.95,
      "scale": 1.02,
      "rotation": 60.0,
      "glow": 0.9,
      "pulse": 0.45
    },
    {
      "time": 0.8,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 120.0,
      "glow": 1.05,
      "pulse": 0.75
    },
    {
      "time": 1.2,
      "opacity": 0.95,
      "scale": 1.02,
      "rotation": 180.0,
      "glow": 0.9,
      "pulse": 0.45
    },
    {
      "time": 1.6,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 240.0,
      "glow": 1.05,
      "pulse": 0.75
    },
    {
      "time": 2.0,
      "opacity": 0.95,
      "scale": 1.02,
      "rotation": 300.0,
      "glow": 0.9,
      "pulse": 0.45
    },
    {
      "time": 2.4,
      "opacity": 0.85,
      "scale": 1.0,
      "rotation": 360.0,
      "glow": 0.7,
      "pulse": 0.2
    }
  ],

  "effects": {
    "rotation": {
      "enabled": true,
      "axis": "z",
      "direction": "clockwise",
      "speed": 150.0,
      "continuous": true
    },

    "glow": {
      "enabled": true,
      "minimum": 0.55,
      "maximum": 1.05,
      "speed": 2.0
    },

    "particles": {
      "enabled": true,
      "count": 35,
      "movement": "orbit",
      "speed": 0.7,
      "radius": 1.1
    },

    "rotationRing": {
      "enabled": true,
      "count": 2,
      "radius": 1.15,
      "thickness": 0.025,
      "rotationSpeed": 180.0,
      "opacity": 0.5
    },

    "scanline": {
      "enabled": true,
      "strength": 0.12,
      "speed": 1.5
    }
  },

  "status": {
    "displayText": "ROTATING",
    "showIndicator": true,
    "indicatorPulse": true
  },

  "sound": {
    "enabled": false,
    "asset": "assets/sounds/rotate.wav",
    "volume": 0.2,
    "loop": true
  },

  "onComplete": {
    "nextState": "rotate"
  },

  "easing": {
    "default": "linear",
    "rotation": "linear",
    "pulse": "ease_in_out"
  }
}