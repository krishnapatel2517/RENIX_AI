{
  "name": "renix_hologram_close",
  "version": "1.0",
  "description": "Holographic interface closing animation for RENIX.",
  "loop": false,
  "duration": 1.5,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.85,
      "scanProgress": 1.0,
      "verticalOffset": 0.0
    },
    {
      "time": 0.25,
      "opacity": 1.0,
      "scale": 1.02,
      "rotation": 0.0,
      "glow": 1.05,
      "scanProgress": 0.85,
      "verticalOffset": 0.0
    },
    {
      "time": 0.5,
      "opacity": 0.85,
      "scale": 0.96,
      "rotation": 0.0,
      "glow": 0.75,
      "scanProgress": 0.65,
      "verticalOffset": -2.0
    },
    {
      "time": 0.75,
      "opacity": 0.6,
      "scale": 0.82,
      "rotation": 0.0,
      "glow": 0.55,
      "scanProgress": 0.45,
      "verticalOffset": -4.0
    },
    {
      "time": 1.0,
      "opacity": 0.35,
      "scale": 0.68,
      "rotation": 0.0,
      "glow": 0.3,
      "scanProgress": 0.25,
      "verticalOffset": -7.0
    },
    {
      "time": 1.25,
      "opacity": 0.12,
      "scale": 0.52,
      "rotation": 0.0,
      "glow": 0.12,
      "scanProgress": 0.1,
      "verticalOffset": -10.0
    },
    {
      "time": 1.5,
      "opacity": 0.0,
      "scale": 0.4,
      "rotation": 0.0,
      "glow": 0.0,
      "scanProgress": 0.0,
      "verticalOffset": -12.0
    }
  ],

  "effects": {
    "scanCollapse": {
      "enabled": true,
      "direction": "top_to_bottom",
      "duration": 1.0,
      "startTime": 0.0,
      "intensity": 1.0
    },

    "glow": {
      "enabled": true,
      "minimum": 0.0,
      "maximum": 1.05,
      "speed": 2.4
    },

    "gridCollapse": {
      "enabled": true,
      "startScale": 1.0,
      "endScale": 0.35,
      "duration": 1.2
    },

    "rings": {
      "enabled": true,
      "count": 3,
      "startRadius": 1.3,
      "endRadius": 0.2,
      "rotationSpeed": -100.0,
      "opacity": 0.65
    },

    "particles": {
      "enabled": true,
      "count": 90,
      "movement": "radial_outward",
      "speed": 1.4,
      "radius": 1.5
    },

    "scanlines": {
      "enabled": true,
      "strength": 0.2,
      "speed": 2.4
    },

    "distortion": {
      "enabled": true,
      "strength": 0.1,
      "duration": 0.45
    },

    "finalFlash": {
      "enabled": true,
      "startTime": 1.15,
      "duration": 0.12,
      "strength": 0.3
    }
  },

  "status": {
    "displayText": "HOLOGRAM OFFLINE",
    "showIndicator": true,
    "indicatorPulse": false
  },

  "sound": {
    "enabled": true,
    "asset": "assets/sounds/hologram_close.wav",
    "volume": 0.4
  },

  "onComplete": {
    "nextState": "idle"
  },

  "easing": {
    "default": "ease_in_out",
    "exit": "ease_in",
    "collapse": "ease_in_out"
  }
}