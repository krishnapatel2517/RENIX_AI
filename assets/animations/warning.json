{
  "name": "renix_warning",
  "version": "1.0",
  "description": "Warning animation displayed when RENIX detects a condition that requires user attention.",
  "loop": false,
  "duration": 1.6,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 0.0,
      "scale": 0.9,
      "rotation": 0.0,
      "glow": 0.2,
      "pulse": 0.0,
      "shake": 0.0
    },
    {
      "time": 0.2,
      "opacity": 0.7,
      "scale": 1.06,
      "rotation": 0.0,
      "glow": 0.9,
      "pulse": 1.0,
      "shake": 0.0
    },
    {
      "time": 0.4,
      "opacity": 1.0,
      "scale": 0.98,
      "rotation": 0.0,
      "glow": 1.15,
      "pulse": 0.6,
      "shake": 0.0
    },
    {
      "time": 0.7,
      "opacity": 1.0,
      "scale": 1.02,
      "rotation": 0.0,
      "glow": 1.0,
      "pulse": 1.0,
      "shake": 0.0
    },
    {
      "time": 1.0,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.45,
      "shake": 0.0
    },
    {
      "time": 1.3,
      "opacity": 1.0,
      "scale": 1.015,
      "rotation": 0.0,
      "glow": 1.0,
      "pulse": 0.8,
      "shake": 0.0
    },
    {
      "time": 1.6,
      "opacity": 1.0,
      "scale": 1.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.2,
      "shake": 0.0
    }
  ],

  "effects": {
    "warningPulse": {
      "enabled": true,
      "speed": 2.5,
      "strength": 0.5,
      "repeat": 2
    },

    "warningRing": {
      "enabled": true,
      "count": 2,
      "radius": 1.2,
      "rotationSpeed": 70.0,
      "opacity": 0.65
    },

    "glow": {
      "enabled": true,
      "minimum": 0.65,
      "maximum": 1.15,
      "speed": 2.8
    },

    "scanline": {
      "enabled": true,
      "strength": 0.22,
      "speed": 2.5
    },

    "particles": {
      "enabled": true,
      "count": 60,
      "movement": "orbit",
      "speed": 0.8,
      "radius": 1.25
    },

    "attentionFlash": {
      "enabled": true,
      "startTime": 0.15,
      "duration": 0.25,
      "strength": 0.35
    }
  },

  "status": {
    "displayText": "WARNING",
    "showIndicator": true,
    "indicatorPulse": true
  },

  "sound": {
    "enabled": true,
    "asset": "assets/sounds/warning.wav",
    "volume": 0.5
  },

  "onComplete": {
    "nextState": "idle"
  },

  "easing": {
    "default": "ease_in_out",
    "pulse": "ease_in_out",
    "settle": "ease_out"
  }
}