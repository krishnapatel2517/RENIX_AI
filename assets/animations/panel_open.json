{
  "name": "renix_panel_open",
  "version": "1.0",
  "description": "Holographic panel opening animation for RENIX.",
  "loop": false,
  "duration": 1.2,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 0.0,
      "scale": 0.8,
      "x": 0.0,
      "y": 8.0,
      "rotation": 0.0,
      "glow": 0.1
    },
    {
      "time": 0.15,
      "opacity": 0.35,
      "scale": 0.88,
      "x": 0.0,
      "y": 5.0,
      "rotation": 0.0,
      "glow": 0.4
    },
    {
      "time": 0.35,
      "opacity": 0.75,
      "scale": 0.96,
      "x": 0.0,
      "y": 2.0,
      "rotation": 0.0,
      "glow": 0.8
    },
    {
      "time": 0.55,
      "opacity": 1.0,
      "scale": 1.04,
      "x": 0.0,
      "y": -1.0,
      "rotation": 0.0,
      "glow": 1.1
    },
    {
      "time": 0.75,
      "opacity": 1.0,
      "scale": 0.99,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.9
    },
    {
      "time": 1.0,
      "opacity": 1.0,
      "scale": 1.01,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.95
    },
    {
      "time": 1.2,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.85
    }
  ],

  "effects": {
    "edgeReveal": {
      "enabled": true,
      "direction": "center_outward",
      "duration": 0.6,
      "intensity": 1.0
    },

    "glow": {
      "enabled": true,
      "minimum": 0.2,
      "maximum": 1.1,
      "speed": 2.5
    },

    "scanline": {
      "enabled": true,
      "strength": 0.18,
      "speed": 2.0
    },

    "particles": {
      "enabled": true,
      "count": 35,
      "movement": "outward",
      "speed": 0.8,
      "radius": 0.9
    },

    "borderPulse": {
      "enabled": true,
      "strength": 0.7,
      "duration": 0.8,
      "repeat": 1
    }
  },

  "status": {
    "displayText": "PANEL OPEN",
    "showIndicator": true,
    "indicatorPulse": true
  },

  "sound": {
    "enabled": true,
    "asset": "assets/sounds/panel_open.wav",
    "volume": 0.35
  },

  "onComplete": {
    "nextState": "idle"
  },

  "easing": {
    "default": "ease_in_out",
    "entrance": "ease_out",
    "settle": "ease_in_out"
  }
}