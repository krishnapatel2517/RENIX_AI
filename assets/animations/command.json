{
  "name": "renix_command",
  "version": "1.0",
  "description": "Command execution animation for the RENIX holographic interface.",
  "loop": false,
  "duration": 1.5,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 0.0,
      "scale": 0.88,
      "x": 0.0,
      "y": 12.0,
      "rotation": 0.0,
      "glow": 0.15,
      "pulse": 0.0
    },
    {
      "time": 0.2,
      "opacity": 0.5,
      "scale": 0.95,
      "x": 0.0,
      "y": 5.0,
      "rotation": 0.0,
      "glow": 0.55,
      "pulse": 0.4
    },
    {
      "time": 0.4,
      "opacity": 1.0,
      "scale": 1.04,
      "x": 0.0,
      "y": -2.0,
      "rotation": 0.0,
      "glow": 1.1,
      "pulse": 1.0
    },
    {
      "time": 0.65,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.9,
      "pulse": 0.5
    },
    {
      "time": 0.9,
      "opacity": 1.0,
      "scale": 1.015,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 1.0,
      "pulse": 0.75
    },
    {
      "time": 1.2,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.8,
      "pulse": 0.2
    },
    {
      "time": 1.5,
      "opacity": 0.0,
      "scale": 0.96,
      "x": 0.0,
      "y": -6.0,
      "rotation": 0.0,
      "glow": 0.0,
      "pulse": 0.0
    }
  ],

  "effects": {
    "commandPulse": {
      "enabled": true,
      "startTime": 0.3,
      "duration": 0.8,
      "strength": 0.8,
      "repeat": 2
    },

    "glow": {
      "enabled": true,
      "minimum": 0.55,
      "maximum": 1.1,
      "speed": 2.6
    },

    "scanline": {
      "enabled": true,
      "strength": 0.2,
      "speed": 2.2
    },

    "particles": {
      "enabled": true,
      "count": 45,
      "movement": "inward",
      "speed": 0.9,
      "radius": 1.1
    },

    "commandSweep": {
      "enabled": true,
      "direction": "left_to_right",
      "duration": 0.35,
      "startTime": 0.15,
      "strength": 0.7
    }
  },

  "status": {
    "displayText": "COMMAND",
    "showIndicator": true,
    "indicatorPulse": true
  },

  "sound": {
    "enabled": true,
    "asset": "assets/sounds/command.wav",
    "volume": 0.4
  },

  "onComplete": {
    "nextState": "processing"
  },

  "easing": {
    "default": "ease_in_out",
    "entrance": "ease_out",
    "exit": "ease_in"
  }
}