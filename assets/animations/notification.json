{
  "name": "renix_notification",
  "version": "1.0",
  "description": "Notification entrance, attention and exit animation for the RENIX holographic interface.",
  "loop": false,
  "duration": 1.8,
  "fps": 60,

  "keyframes": [
    {
      "time": 0.0,
      "opacity": 0.0,
      "scale": 0.85,
      "x": 40.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.2,
      "pulse": 0.0
    },
    {
      "time": 0.2,
      "opacity": 0.45,
      "scale": 0.94,
      "x": 18.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.55,
      "pulse": 0.3
    },
    {
      "time": 0.45,
      "opacity": 1.0,
      "scale": 1.03,
      "x": -3.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 1.05,
      "pulse": 1.0
    },
    {
      "time": 0.7,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.35
    },
    {
      "time": 1.2,
      "opacity": 1.0,
      "scale": 1.0,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.85,
      "pulse": 0.2
    },
    {
      "time": 1.5,
      "opacity": 0.9,
      "scale": 0.98,
      "x": 0.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.7,
      "pulse": 0.0
    },
    {
      "time": 1.8,
      "opacity": 0.0,
      "scale": 0.94,
      "x": 25.0,
      "y": 0.0,
      "rotation": 0.0,
      "glow": 0.0,
      "pulse": 0.0
    }
  ],

  "effects": {
    "notificationPulse": {
      "enabled": true,
      "startTime": 0.35,
      "duration": 0.7,
      "strength": 0.75,
      "repeat": 2
    },

    "glow": {
      "enabled": true,
      "minimum": 0.65,
      "maximum": 1.05,
      "speed": 2.2
    },

    "scanline": {
      "enabled": true,
      "strength": 0.15,
      "speed": 1.8
    },

    "particles": {
      "enabled": true,
      "count": 35,
      "movement": "outward",
      "speed": 0.7,
      "radius": 0.8
    }
  },

  "status": {
    "displayText": "NOTIFICATION",
    "showIndicator": true,
    "indicatorPulse": true
  },

  "sound": {
    "enabled": true,
    "asset": "assets/sounds/notification.wav",
    "volume": 0.45
  },

  "onComplete": {
    "nextState": "idle"
  },

  "easing": {
    "default": "ease_in_out",
    "entrance": "ease_out",
    "exit": "ease_in"
  }
}